#!/usr/bin/env ruby
# release-audit

# 20260911
# 0.2.1

gem 'switches.rb'

require 'json'
require 'switches.rb'

DEFAULT_BRANCH = 'master'
DEFAULT_CONFIG_FILEPATH = File.join('~', '.config', 'release-audit', 'config.json')
DEFAULT_ROOT = File.expand_path('.')
COPY_SUFFIXES = %w{.bak .old .orig}
CURRENT = :current
LISTED_VERSIONS = 6
MINIMUM_NAME_WIDTH = 24
OLDER = :older
OWNER = 'thoran'
VERSION_SUBJECT = /\A(\d+\.\d+\.\d+):/
VERSION_TAG = /\Av(\d+\.\d+\.\d+)\z/
WORKING = :working

def usage
  puts "release-audit - Report which repositories have a release left half done."
  puts
  puts "Usage: release-audit [options]"
  puts
  puts "Options:"
  puts "  -c, --config FILE   Where the configuration is (default: #{DEFAULT_CONFIG_FILEPATH})"
  puts "  -r, --root DIR      Where the repositories are (default: the configured one, else .)"
  puts "  -B, --branch NAME   The branch each repository releases from (default: #{DEFAULT_BRANCH})"
  puts "  -a, --all           List every repository, not only those with something outstanding"
  puts "  -n, --name          Head the repository column, which is otherwise left unheaded"
  puts "  -h, --help          Show this help"
  puts
  puts "Three columns, none of which touches the network: whether the tree is"
  puts "committed, which versions the repository claims and has tagged, and whether"
  puts "the branch is pushed.  Whether a tag is on the remote and whether a version"
  puts "is published are the two remaining columns and are not asked here yet."
  puts
  puts "Exits 1 where anything was found, so it can gate a release."
end

def switches
  @switches ||= Switches.new do |s|
    s.optional(:c, :config){'Where the configuration is'}
    s.optional(:r, :root){'Where the repositories are'}
    s.optional(:B, :branch, default: DEFAULT_BRANCH){'The branch each repository releases from'}
    s.boolean(:a, :all){'List every repository'}
    s.boolean(:n, :name){'Head the repository column'}
    s.perform(:h, :help?) do
      usage
      exit
    end
  end
end

def config_filepath
  File.expand_path(switches.config || DEFAULT_CONFIG_FILEPATH)
end

# Absent is legitimate: run from a directory of repositories, the default root is
# already right and there is nothing to configure.
def config
  @config ||= (
    if File.exist?(config_filepath)
      JSON.parse(File.read(config_filepath), symbolize_names: true)
    else
      {}
    end
  )
end

def root
  @root ||= File.expand_path(switches.root || config[:root] || DEFAULT_ROOT)
end

def git(path, *arguments)
  `git -C #{path.inspect} #{arguments.join(' ')} 2>/dev/null`
end

# A copy carries its original's history and would be reported as a second
# repository claiming the same versions, which is no more true of it than of any
# other stale checkout.  ' copy' is what the Finder appends and '.bak' is what a
# hand appends, and both name the same thing.
def copy?(path)
  File.basename(path) =~ / copy\b/ || File.basename(path).end_with?(*COPY_SUFFIXES)
end

# A fork cannot be released from here, so every column is meaningless for one and
# the noise is considerable: homebrew-core alone reported 249 uncommitted files on
# the first run.  The root commit's author is the proxy used where gh is not to
# hand, and it is a proxy: a
# repository whose history was grafted reads as ours, and one begun before the
# convention of a first commit of one's own reads as somebody else's.
def ours?(path)
  root_commit = git(path, 'rev-list', '--max-parents=0', 'HEAD').lines.last.to_s.strip
  return false if root_commit.empty?
  git(path, 'log', '-1', '--format=%ae', root_commit).include?(OWNER)
end

def repository_paths
  @repository_paths ||= Dir[File.join(root, '*')].sort.select do |path|
    File.directory?(File.join(path, '.git')) && !copy?(path) && ours?(path)
  end
end

def uncommitted(path)
  git(path, 'status', '--porcelain').lines.size
end

def tagged_versions(path)
  git(path, 'tag', '--list').lines.collect{|line| line.strip[VERSION_TAG, 1]}.compact
end

# What the repository says of itself, which is the commit subjects.  The changelog
# says it too and in three different formats, so it is left to a later revision.
def claimed_versions(path)
  git(path, 'log', '--format=%s').lines.collect{|line| line.strip[VERSION_SUBJECT, 1]}.compact.uniq
end

def latest_version(path)
  (tagged_versions(path) + claimed_versions(path)).max_by{|version| Gem::Version.new(version)}
end

def upstream?(path)
  !git(path, 'rev-parse', '--abbrev-ref', '@{u}').strip.empty?
end

def unpushed(path)
  return nil unless upstream?(path)
  git(path, 'rev-list', '--count', '@{u}..').strip.to_i
end

# Naming them all is unreadable where a repository has never been tagged at all:
# dsv claims 77 versions and shellac 21.
def listed(versions)
  return versions.join(', ') if versions.size <= LISTED_VERSIONS
  versions.first(LISTED_VERSIONS).join(', ') + ", and #{versions.size - LISTED_VERSIONS} more"
end

# Three states, and only the second is a release left half done.  A repository
# which has never been tagged says something about its whole history rather than
# about its last release, and saying so once is worth more than naming 77
# versions: dsv claims that many and shellac 21.  A gap behind a tagged latest is
# backfill, which thoran does years after the fact by design.
def untagged_findings(path)
  claimed = claimed_versions(path)
  return [] if claimed.empty?
  tagged = tagged_versions(path)
  return [["never tagged, #{claimed.size} #{claimed.size == 1 ? 'version' : 'versions'} claimed", OLDER]] if tagged.empty?
  untagged = claimed - tagged
  return [] if untagged.empty?
  latest = claimed.max_by{|version| Gem::Version.new(version)}
  findings = []
  findings << ["#{latest} untagged", CURRENT] if untagged.include?(latest)
  earlier = untagged - [latest]
  findings << ["#{earlier.size} earlier untagged: #{listed(earlier)}", OLDER] unless earlier.empty?
  findings
end

# Three standings, because the counts conflate otherwise.  CURRENT is a release
# which stopped between being made and being delivered: a latest version with no
# tag, or commits the remote has not seen.  WORKING is a tree with changes in it,
# which is work rather than a release, though it makes every later column
# provisional and so is worth saying.  OLDER is merely true: a version untagged
# years ago, or a repository which never had a remote.  Counted as one, 24 of the
# 37 were WORKING and none at all was a latest version untagged.
def findings(path)
  findings = []
  count = uncommitted(path)
  findings << ["#{count} uncommitted", WORKING] if count > 0
  findings.concat(untagged_findings(path))
  ahead = unpushed(path)
  if ahead.nil?
    findings << ['no upstream', OLDER]
  elsif ahead > 0
    findings << ["#{ahead} unpushed", CURRENT]
  end
  findings
end

# A repository stands where its gravest finding does.
def standing(findings)
  return CURRENT if findings.any?{|_, standing| standing == CURRENT}
  return WORKING if findings.any?{|_, standing| standing == WORKING}
  OLDER
end

def committed(path)
  count = uncommitted(path)
  return 'clean' if count.zero?
  "#{count} #{count == 1 ? 'file' : 'files'}"
end

# Fitted to the longest name reported rather than fixed.  Truncating would cost
# the one column which identifies the row, and a name wider than a fixed column
# pushes every column after it out of true: whitehorse-gutter-cleaning is 26.
def name_width(paths)
  [paths.collect{|path| File.basename(path).size}.max.to_i, MINIMUM_NAME_WIDTH].max
end

def row(width)
  "%-#{width}s %-12s %-10s %s"
end

# The name column is headed only where it is asked for: a column of repository
# names says what it is, and a heading over it is one more line to read past.
def headings(width)
  puts row(width) % [switches.name? ? 'repository' : '', 'committed', 'version', 'outstanding']
  puts row(width) % ['-' * (switches.name? ? 10 : 0), '-' * 9, '-' * 7, '-' * 11]
end

def report(path, findings, width)
  puts row(width) % [
    File.basename(path),
    committed(path),
    latest_version(path) || '--',
    findings.collect(&:first).join('; '),
  ]
end

def summary(counts, total)
  return puts("No repositories of ours beneath #{root}.") if total.zero?
  return puts("Nothing outstanding in #{total} #{total == 1 ? 'repository' : 'repositories'}.") if counts.values.sum.zero?
  clauses = []
  clauses << "#{counts[CURRENT]} of #{total} #{counts[CURRENT] == 1 ? 'repository has' : 'repositories have'} a release left half done" unless counts[CURRENT].zero?
  clauses << "#{counts[WORKING]} #{counts[WORKING] == 1 ? 'has' : 'have'} work in progress" unless counts[WORKING].zero?
  clauses << "#{counts[OLDER]} #{counts[OLDER] == 1 ? 'has' : 'have'} something older outstanding" unless counts[OLDER].zero?
  clauses[-1] = "and #{clauses[-1]}" if clauses.size > 1
  puts clauses.join(clauses.size > 2 ? ', ' : ' ') + '.'
end

def main
  switches
  reported = []
  repository_paths.each do |path|
    found = findings(path)
    reported << [path, found] unless found.empty?
  end
  listable = switches.all? ? repository_paths.collect{|path| [path, findings(path)]} : reported
  width = name_width(listable.collect(&:first))
  headings(width) unless listable.empty?
  listable.each{|path, found| report(path, found, width)}
  counts = Hash.new(0)
  reported.each{|_, found| counts[standing(found)] += 1}
  puts
  summary(counts, repository_paths.size)
  exit(reported.empty? ? 0 : 1)
end

main
